flowchart TD
    START(["시작"])
    ENTER[/"사용자: 홈 또는 직접 링크 진입"/]
    ROUTE{"진입 경로?"}
    HOME[["P-001 홈"]]
    CHOOSE[/"사용자: 탐색 정보 선택"/]
    DETAIL[["P-002 제품 상세"]]
    PICK[/"사용자: 구조 항목 선택"/]
    LOAD{"자료가 존재하는가?"}
    SHOW["시스템: 구조·검증 상태 표시"]
    GUIDE[["P-003 사용 안내"]]
    STEP[/"사용자: 상황·단계 선택"/]
    PREV{"이전 단계인가?"}
    UPDATE["시스템: 현재 단계 갱신"]
    TRUST[["P-004 성분·영양"]]
    OPEN[/"사용자: 상세 정보 펼치기"/]
    EMPTY{"표시할 결과가 있는가?"}
    RESULT["시스템: 근거와 결과 표시"]
    EMPTY_STATE["시스템: 빈 상태와 복귀 수단 표시"]
    ERROR_STATE["시스템: 오류와 재시도 표시"]
    MORE{"추가 정보가 필요한가?"}
    END(["정보 확인 완료"])

    START --> ENTER --> ROUTE
    ROUTE -->|홈| HOME
    ROUTE -->|제품| DETAIL
    ROUTE -->|사용 안내| GUIDE
    ROUTE -->|성분·영양| TRUST
    HOME --> CHOOSE --> DETAIL
    DETAIL --> PICK --> LOAD
    LOAD -->|예| SHOW --> GUIDE
    LOAD -->|아니오| EMPTY_STATE
    LOAD -. "로드 오류" .-> ERROR_STATE
    GUIDE --> STEP --> PREV
    PREV -->|예| UPDATE --> GUIDE
    PREV -->|아니오| UPDATE --> TRUST
    TRUST --> OPEN --> EMPTY
    EMPTY -->|예| RESULT --> MORE
    EMPTY -->|아니오| EMPTY_STATE
    EMPTY_STATE -->|이전 화면| DETAIL
    EMPTY_STATE -->|홈| HOME
    ERROR_STATE -->|재시도| LOAD
    ERROR_STATE -->|홈| HOME
    MORE -->|예| DETAIL
    MORE -->|아니오| END
    DETAIL -->|여기서 완료| END
    GUIDE -->|여기서 완료| END
