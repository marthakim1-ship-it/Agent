flowchart TD
    start(["시작"])
    home["홈"]
    choose{"확인 목적 선택"}
    productInfo["제품 정보"]
    compare["제품 비교"]
    inputValid{"조건 유효?"}
    noResult["결과 없음"]
    ingredients["원료 및 성분"]
    nutrition["영양 정보"]
    allergy["알레르기 및 주의"]
    evidence["인증 및 근거"]
    status["검증 상태"]
    detail["제품 상세"]
    confirmed{"근거 확정?"}
    action["다음 행동"]
    loginNeeded{"로그인 필요?"}
    channelReady{"구매 채널 확정?"}
    purchase["구매 안내"]
    pending["준비 중 안내"]
    errorPage["오류 안내"]
    finish(["종료"])

    start --> home --> choose
    choose -->|"제품 비교"| productInfo --> compare --> inputValid
    inputValid -->|"오류"| compare
    inputValid -->|"결과 없음"| noResult --> compare
    inputValid -->|"결과 있음"| detail
    choose -->|"성분 확인"| ingredients --> detail
    choose -->|"영양 확인"| nutrition --> detail
    choose -->|"주의 확인"| allergy --> detail
    choose -->|"근거 확인"| evidence --> status --> detail
    detail --> confirmed
    confirmed -->|"미검증"| status
    confirmed -->|"확정"| action --> loginNeeded
    loginNeeded -->|"아니요"| channelReady
    loginNeeded -->|"예: 가정"| pending
    channelReady -->|"예"| purchase --> finish
    channelReady -->|"아니요"| pending --> detail
    purchase -.->|"연결 오류"| errorPage
    errorPage -->|"재시도"| purchase
    errorPage -->|"홈"| home

    classDef terminal fill:#CDF4D3,stroke:#66D575
    classDef decision fill:#FFECBD,stroke:#FFC943
    classDef exception fill:#FFCDC2,stroke:#FF7556
    class start,finish terminal
    class choose,inputValid,confirmed,loginNeeded,channelReady decision
    class noResult,pending,errorPage exception
