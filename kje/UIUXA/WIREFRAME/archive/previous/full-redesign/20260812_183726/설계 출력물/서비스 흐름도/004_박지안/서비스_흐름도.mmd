flowchart TD
    start(["시작"])
    home["홈"]
    choose{"탐색 목적 선택"}
    situations["사용 상황"]
    method["사용 방법"]
    products["제품"]
    compare["제품 비교"]
    inputValid{"조건 유효?"}
    noResult["결과 없음"]
    info["제품 정보"]
    detail["제품 상세"]
    action["다음 행동"]
    loginNeeded{"로그인 필요?"}
    channelReady{"판매 채널 확정?"}
    retailer["판매처 안내"]
    policyReady{"구매 정책 확정?"}
    policy["구매 정책 상태"]
    pending["준비 중 안내"]
    errorPage["오류 안내"]
    finish(["종료"])

    start --> home --> choose
    choose -->|"상황 탐색"| situations --> method --> detail
    choose -->|"제품 탐색"| products --> compare --> inputValid
    situations --> compare
    inputValid -->|"오류"| compare
    inputValid -->|"결과 없음"| noResult --> compare
    inputValid -->|"결과 있음"| info --> detail
    detail --> action --> loginNeeded
    loginNeeded -->|"예: 가정"| pending
    loginNeeded -->|"아니요"| channelReady
    channelReady -->|"예"| retailer --> policyReady
    channelReady -->|"아니요"| pending
    policyReady -->|"예"| policy --> finish
    policyReady -->|"아니요"| pending --> detail
    retailer -.->|"연결 오류"| errorPage
    errorPage -->|"재시도"| retailer
    errorPage -->|"홈"| home

    classDef terminal fill:#CDF4D3,stroke:#66D575
    classDef decision fill:#FFECBD,stroke:#FFC943
    classDef exception fill:#FFCDC2,stroke:#FF7556
    class start,finish terminal
    class choose,inputValid,loginNeeded,channelReady,policyReady decision
    class noResult,pending,errorPage exception
