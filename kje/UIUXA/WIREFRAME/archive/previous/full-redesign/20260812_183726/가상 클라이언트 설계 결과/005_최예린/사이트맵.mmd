flowchart TD
    home(["홈"])
    brand["브랜드"]
    products["제품"]
    gallery["제품 갤러리"]
    groups["제품군"]
    method["사용 방법"]
    scenes["사용 장면"]
    info["제품 정보"]
    assets["자산 상태"]
    content["콘텐츠"]
    detail["제품 상세"]
    action["다음 행동"]
    pending["준비 중 안내"]
    noResult["결과 없음"]
    errorPage["오류 안내"]

    home --> brand
    home --> products
    home --> scenes
    brand --> content
    products --> gallery
    products --> groups
    products --> detail
    gallery --> method
    gallery --> detail
    groups --> detail
    groups -.->|"라인업 미확정"| noResult
    noResult --> products
    scenes --> content
    scenes --> detail
    method --> detail
    content --> info
    content --> detail
    info --> assets
    assets --> detail
    detail --> action
    action -.->|"행동 미확정"| pending
    pending --> detail
    errorPage --> home

    classDef common fill:#C2E5FF,stroke:#3DADFF
    classDef conditional fill:#FFECBD,stroke:#FFC943
    classDef exception fill:#FFCDC2,stroke:#FF7556
    class home,brand,products,gallery,groups,method,scenes,info,content,detail common
    class assets,action,pending conditional
    class noResult,errorPage exception
