flowchart TD
    start(["시작"])
    home["홈"]
    choose{"탐색 목적 선택"}
    explore["제품"]
    compare["제품 비교"]
    hasResult{"결과 있음?"}
    noResult["결과 없음"]
    detail["제품 상세"]
    scene["사용 상황"]
    method["사용 방법"]
    ingredients["원료 및 영양"]
    evidence["검증 정보"]
    action["다음 행동"]
    channelReady{"판매 채널 확정?"}
    retailer["판매처 안내"]
    pending["준비 중 안내"]
    loginNeeded{"로그인 필요?"}
    external["외부 판매처 이동"]
    error{"입력 또는 연결 오류?"}
    errorPage["오류 안내"]
    finish(["종료"])

    start --> home --> choose
    choose -->|"제품 탐색"| explore --> compare --> hasResult
    hasResult -->|"없음"| noResult --> compare
    hasResult -->|"있음"| detail
    choose -->|"상황 탐색"| scene --> method --> detail
    choose -->|"신뢰 확인"| ingredients --> evidence --> detail
    detail --> action --> channelReady
    channelReady -->|"예"| retailer --> loginNeeded
    channelReady -->|"아니요"| pending --> detail
    loginNeeded -->|"아니요"| external --> error
    loginNeeded -->|"예: 가정"| pending
    error -->|"정상"| finish
    error -->|"오류"| errorPage
    errorPage -->|"재시도"| retailer
    errorPage -->|"홈"| home

    classDef terminal fill:#CDF4D3,stroke:#66D575
    classDef decision fill:#FFECBD,stroke:#FFC943
    classDef exception fill:#FFCDC2,stroke:#FF7556
    class start,finish terminal
    class choose,hasResult,channelReady,loginNeeded,error decision
    class noResult,pending,errorPage exception
