flowchart TD
  START(["시작"])
  HOME["P00 홈"]
  INTENT{"탐색 목적"}
  USE["P40 사용 상황"]
  USEDETAIL["P41 상황 상세"]
  LIST["P21 제품 목록"]
  HASRESULT{"제품 결과 있음?"}
  EMPTY["P81 결과 없음"]
  COMPARE["P23 제품 비교"]
  DETAIL["P22 제품 상세"]
  CHECK{"추가 확인 항목"}
  STRUCTURE["P30 제품 구조"]
  HOWTO["P31 사용 방법"]
  TRUST["P50 성분·영양"]
  EVIDENCE["P51 검증 정보"]
  ACTIONREADY{"판매 채널 확정?"}
  ACTION["P60 판매처·다음 행동"]
  OUT(["외부 채널 이동 / 종료"])
  HOLD["P22 제품 상세\n미확정 상태 안내"]
  LOGINQ{"로그인 필요?\n가정"}
  LOGIN["P70 로그인"]
  VALID{"입력값 유효?"}
  AUTH{"인증 성공?"}
  MY["P71 내 활동"]
  ERROR["P82 오류 안내"]
  RETRY{"재시도?"}
  EXIT(["이탈"])

  START --> HOME --> INTENT
  INTENT -- "상황 탐색" --> USE --> USEDETAIL --> DETAIL
  INTENT -- "제품 탐색" --> LIST --> HASRESULT
  HASRESULT -- "아니오" --> EMPTY --> LIST
  HASRESULT -- "예" --> COMPARE --> DETAIL
  INTENT -- "직접 상세" --> DETAIL
  DETAIL --> CHECK
  CHECK -- "구조" --> STRUCTURE --> HOWTO --> DETAIL
  CHECK -- "성분·영양" --> TRUST --> EVIDENCE --> DETAIL
  CHECK -- "핵심 행동" --> ACTIONREADY
  ACTIONREADY -- "예" --> ACTION --> OUT
  ACTIONREADY -- "아니오" --> HOLD --> DETAIL
  DETAIL -. "저장 기능 사용: 가정" .-> LOGINQ
  LOGINQ -- "아니오" --> MY
  LOGINQ -- "예" --> LOGIN --> VALID
  VALID -- "아니오" --> LOGIN
  VALID -- "예" --> AUTH
  AUTH -- "성공" --> MY --> DETAIL
  AUTH -- "실패" --> ERROR --> RETRY
  RETRY -- "로그인 재시도" --> LOGIN
  RETRY -- "홈 복귀" --> HOME
  RETRY -- "종료" --> EXIT
  HOME -. "중단" .-> EXIT
  DETAIL -. "중단" .-> EXIT
  EXIT -. "URL·기록으로 재진입" .-> HOME

  classDef terminal fill:#111827,stroke:#111827,color:#fff;
  classDef user fill:#eef7ff,stroke:#2563eb,color:#111827;
  classDef system fill:#ecfdf5,stroke:#059669,color:#111827;
  classDef decision fill:#fff7ed,stroke:#ea580c,color:#111827;
  classDef error fill:#fef2f2,stroke:#dc2626,color:#111827;
  class START,OUT,EXIT terminal;
  class HOME,USE,USEDETAIL,LIST,COMPARE,DETAIL,STRUCTURE,HOWTO,TRUST,EVIDENCE,ACTION,LOGIN,MY user;
  class HOLD system;
  class INTENT,HASRESULT,CHECK,ACTIONREADY,LOGINQ,VALID,AUTH,RETRY decision;
  class EMPTY,ERROR error;
